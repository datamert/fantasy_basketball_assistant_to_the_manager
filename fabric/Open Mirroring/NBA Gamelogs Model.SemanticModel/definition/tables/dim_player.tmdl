table dim_player
	lineageTag: ab7a8b1f-836c-43ec-9827-bd6a6c29cc7b
	sourceLineageTag: [semantic].[dim_player]

	measure 'Current Team' =
			
			VAR LatestGameDate = MAX(fct_gamelogs[Game Date])
			VAR LatestTeamID = CALCULATE(MAX(fct_gamelogs[Team ID]), fct_gamelogs[Game Date] = LatestGameDate)
			RETURN LOOKUPVALUE(dim_team[Name], dim_team[ID], LatestTeamID)
		lineageTag: 426a2bee-a0ca-48ff-a261-1388e6182d6e

		changedProperty = Name

	measure 'Current Team Logo URL' =
			
			VAR LatestGameDate = MAX(fct_gamelogs[Game Date])
			VAR LatestTeamID = CALCULATE(MAX(fct_gamelogs[Team ID]), fct_gamelogs[Game Date] = LatestGameDate)
			RETURN LOOKUPVALUE(dim_team[Team Logo URL], dim_team[ID], LatestTeamID)
		lineageTag: b9c92dd6-b2cf-4bfb-925c-76bd86ff39e6
		dataCategory: ImageUrl

		changedProperty = Name

		changedProperty = DataCategory

	measure 'Current Status' = COALESCE(FIRSTNONBLANKVALUE('dim_player'[Current Injury Status], 1), "Available")
		lineageTag: 72732bdd-5039-4b7d-9b8f-e68e2fc00901

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

