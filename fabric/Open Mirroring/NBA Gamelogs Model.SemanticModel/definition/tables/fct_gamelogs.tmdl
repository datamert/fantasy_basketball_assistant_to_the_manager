table fct_gamelogs
	lineageTag: cfe5cd70-b819-4eea-a67c-8bec181618ae
	sourceLineageTag: [semantic].[fct_gamelogs]

	measure FPTS =
			CALCULATE(COUNTROWS(fct_gamelogs), fct_gamelogs[AST] >= 15) * '15+ Assists Bonus'[15+ Assists Bonus Value]
			+ SUM(fct_gamelogs[FG3A]) * '3-point Shots Attempted'[3-point Shots Attempted Value]
			+ SUM(fct_gamelogs[FG3M]) * '3-point Shots Made'[3-point Shots Made Value]
			+ (SUM(fct_gamelogs[FG3A]) - SUM(fct_gamelogs[FG3M])) * '3-point Shots Missed'[3-point Shots Missed Value]
			+ CALCULATE(COUNTROWS(fct_gamelogs), fct_gamelogs[REB] >= 20) * '20+ Rebounds Bonus'[20+ Rebounds Bonus Value]
			+ CALCULATE(COUNTROWS(fct_gamelogs), fct_gamelogs[PTS] >= 40) * '40+ Points Bonus'[40+ Points Bonus Value]
			+ CALCULATE(COUNTROWS(fct_gamelogs), fct_gamelogs[PTS] >= 50) * '50+ Points Bonus'[50+ Points Bonus Value]
			+ SUM(fct_gamelogs[AST]) * Assist[Assist Value]
			+ SUM(fct_gamelogs[BLK]) * Block[Block Value]
			+ SUM(fct_gamelogs[DREB]) * 'Defensive Rebound'[Defensive Rebound Value]
			+ SUM(fct_gamelogs[DD2]) * 'Double-Double'[Double-Double Value]
			+ SUM(fct_gamelogs[FGA]) * 'Field Goals Attempted'[Field Goals Attempted Value]
			+ SUM(fct_gamelogs[FGM]) * 'Field Goals Made'[Field Goals Made Value]
			//+ _ * 'Flagrant Foul'[Flagrant Foul Value]
			+ SUM(fct_gamelogs[FTA]) * 'Free Throws Attempted'[Free Throws Attempted Value]
			+ SUM(fct_gamelogs[FTM]) * 'Free Throws Made'[Free Throws Made Value]
			+ (SUM(fct_gamelogs[FTA]) - SUM(fct_gamelogs[FTM])) * 'Free Throws Missed'[Free Throws Missed Value]
			+ SUM(fct_gamelogs[OREB]) * 'Offensive Rebound'[Offensive Rebound Value]
			+ SUM(fct_gamelogs[PF]) * 'Personal Foul'[Personal Foul Value]
			+ SUM('Plus/minus'[Plus/minus]) * 'Plus/minus'[Plus/minus Value]
			+ SUM(fct_gamelogs[PTS]) * 'Points Scored'[Points Scored Value]
			+ SUM(fct_gamelogs[REB]) * Rebound[Rebound Value]
			+ SUM(fct_gamelogs[STL]) * Steal[Steal Value]
			//+ _ * 'Technical Foul'[Technical Foul Value]
			+ SUM(fct_gamelogs[TD3]) * 'Triple-Double'[Triple-Double Value]
			+ SUM(Turnover[Turnover]) * Turnover[Turnover Value]
		lineageTag: 2c5ca93f-d605-4f09-b844-1dcda24277bb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FPTS AVG' = DIVIDE([FPTS], [GP])
		lineageTag: 700fcd3b-8106-44c0-b61a-fb38f425a12d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure GP = COUNTROWS(fct_gamelogs)
